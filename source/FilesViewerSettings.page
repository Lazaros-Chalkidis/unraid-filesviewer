    $new_cfg['FV_PALETTE']       = $one_of($_POST['FV_PALETTE'] ?? 'auto', ['auto','dark','light'], 'auto');
    $new_cfg['FV_NOTIFY']        = $yn($_POST['FV_NOTIFY'] ?? '1', '1');

    $ini = '';
    foreach ($new_cfg as $k => $v) {
        $v = preg_replace('/[\x00-\x1f\x7f]/', '', (string)$v);
        $v = str_replace('"', '\\"', $v);
        $ini .= "{$k}=\"{$v}\"\n";
