$one_of = static function($v, array $allowed, string $default): string {
    $v = strtolower((string)$v);
    return in_array($v, $allowed, true) ? $v : $default;
};

$write_cfg = static function(string $ini): string {
    $dir = dirname(FV_CFG_FILE);
    if (!is_dir($dir) && !@mkdir($dir, 0755, true)) return _('Settings were not saved: the folder on the flash drive could not be created.');
    if (is_file(FV_CFG_FILE) && @file_get_contents(FV_CFG_FILE) === $ini) return '';

    $tmp = FV_CFG_FILE . '.tmp';
    if (@file_put_contents($tmp, $ini) !== strlen($ini) || !@rename($tmp, FV_CFG_FILE)) {
        @unlink($tmp);
        return _('Settings were not saved. Check that the flash drive is mounted and writable.');
    }
    @chmod(FV_CFG_FILE, 0644);
    return '';
};

$save_err = '';

if (isset($_POST['#apply'])) {

    $new_cfg = @parse_ini_file(FV_CFG_FILE) ?: [];

    $new_cfg['FV_SHOW_HIDDEN']   = $yn($_POST['FV_SHOW_HIDDEN']   ?? '0', '0');
    $new_cfg['FV_FOLDERS_FIRST'] = $yn($_POST['FV_FOLDERS_FIRST'] ?? '1', '1');
