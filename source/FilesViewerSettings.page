<div id="fvNoticeModal"<?= $langAttr ?> style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.72);align-items:center;justify-content:center;">
  <div class="fv-credits-modal-box" style="max-width:420px;">
    <div style="padding:1.8rem 2.2rem 1.4rem;text-align:center;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;">

      <div style="width:64px;height:64px;border-radius:50%;background:#3f8a4f;display:flex;align-items:center;justify-content:center;margin-bottom:1.1rem;box-shadow:0 4px 14px rgba(63,138,79,0.35);">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="5 12 10 17 19 8"></polyline>
        </svg>
      </div>
